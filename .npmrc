# Dependency install policy
#
# npm lifecycle scripts (preinstall/install/postinstall) from dependencies are
# NOT executed. This project has no dependency that requires a build step at
# install time, and allowing arbitrary install scripts is the single largest
# supply-chain risk in an npm install.
#
# pnpm equivalent (pnpm >= 10): only the packages listed here may run scripts.
#   pnpm.onlyBuiltDependencies[]=...
# Leave the list empty until a dependency genuinely needs it.

# Do not resolve peer dependencies implicitly — keeps the installed tree
# exactly as recorded in pnpm-lock.yaml.
strict-peer-dependencies=true

# Fail loudly on lockfile drift so a stale lockfile can never be published.
# (pnpm enforces this via --frozen-lockfile in CI.)
resolution-mode=highest
